    <!-- JavaScript for Interactions, Animations & Gemini API -->\
    <script>\
        // --- Gemini API Logic ---\
        const apiKey = ""; // API key is injected by the environment\
\
        async function fetchGeminiWithRetry(prompt, systemInstruction) \{\
            const endpoint = `https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash-preview-09-2025:generateContent?key=$\{apiKey\}`;\
            const retries = 5;\
            const delays = [1000, 2000, 4000, 8000, 16000];\
            \
            const payload = \{\
                contents: [\{ parts: [\{ text: prompt \}] \}],\
                systemInstruction: \{ parts: [\{ text: systemInstruction \}] \}\
            \};\
\
            for (let i = 0; i < retries; i++) \{\
                try \{\
                    const response = await fetch(endpoint, \{\
                        method: 'POST',\
                        headers: \{ 'Content-Type': 'application/json' \},\
                        body: JSON.stringify(payload)\
                    \});\
                    \
                    if (!response.ok) throw new Error(`HTTP $\{response.status\}`);\
                    \
                    const data = await response.json();\
                    return data.candidates?.[0]?.content?.parts?.[0]?.text || "Unable to generate vision at this time.";\
                \} catch (error) \{\
                    if (i === retries - 1) throw error;\
                    await new Promise(res => setTimeout(res, delays[i]));\
                \}\
            \}\
        \}\
\
        async function generateDesignVision() \{\
            const input = document.getElementById('visionInput').value;\
            const btn = document.getElementById('visionBtn');\
            const spinner = document.getElementById('visionSpinner');\
            const outputArea = document.getElementById('visionOutput');\
            const outputText = document.getElementById('visionOutputText');\
            const errorMsg = document.getElementById('visionError');\
\
            if (!input.trim()) return;\
\
            // UI Loading State\
            btn.disabled = true;\
            btn.classList.add('opacity-70');\
            spinner.classList.remove('hidden');\
            outputArea.classList.add('hidden');\
            errorMsg.classList.add('hidden');\
\
            const systemPrompt = `You are the creative director AI for 'Cali Dani Designs', a minimalist, sophisticated, high-end graphic design studio created by Shaneille Bramwell. \
            The user will pitch you a rough idea for a business, brand, or event. \
            Your goal is to return a concise, inspiring 'Design Vision Brief'. \
            Format the response in clean HTML using <p>, <strong> for labels, <br>, and <ul> for lists. NO markdown formatting or code blocks.\
            \
            Your response MUST include:\
            1) <strong>Vibe & Aesthetic:</strong> A 2-sentence description of the artistic direction.\
            2) <strong>Color Palette:</strong> 3-4 specific colors described elegantly (e.g., 'Soft rose, muted charcoal, and crisp linen white').\
            3) <strong>Typography:</strong> Suggest a font pairing (e.g., 'An elegant serif paired with a clean geometric sans-serif').\
            4) <strong>Recommended Package:</strong> Explicitly recommend either 'Logo Design', 'Social Media', or 'Corporate Event Collateral' from the service packages.`;\
\
            try \{\
                const generatedHtml = await fetchGeminiWithRetry(input, systemPrompt);\
                outputText.innerHTML = generatedHtml;\
                outputArea.classList.remove('hidden');\
            \} catch (error) \{\
                console.error("Gemini API Error:", error);\
                errorMsg.classList.remove('hidden');\
            \} finally \{\
                btn.disabled = false;\
                btn.classList.remove('opacity-70');\
                spinner.classList.add('hidden');\
            \}\
        \}\
\
        function prefillInquiryForm() \{\
            const userIdea = document.getElementById('visionInput').value;\
            const generatedHtml = document.getElementById('visionOutputText').innerHTML;\
            \
            // Convert HTML to plain text roughly\
            const tempDiv = document.createElement("div");\
            tempDiv.innerHTML = generatedHtml;\
            const plainTextVision = tempDiv.textContent || tempDiv.innerText || "";\
\
            const formMessage = document.getElementById('message');\
            formMessage.value = `Hi Shaneille,\\n\\nI used your AI Concept Studio for my idea:\\n"$\{userIdea\}"\\n\\nHere is the vision it generated that I would love to explore with you:\\n\\n$\{plainTextVision.trim()\}\\n\\nLet me know the next steps!`;\
            \
            // Try to auto-select the dropdown based on keywords\
            const packageSelect = document.getElementById('packageSelect');\
            const lowerText = plainTextVision.toLowerCase();\
            if (lowerText.includes('logo design') || lowerText.includes('brand')) \{\
                packageSelect.value = 'logo';\
            \} else if (lowerText.includes('social media')) \{\
                packageSelect.value = 'social';\
            \} else if (lowerText.includes('corporate') || lowerText.includes('event')) \{\
                packageSelect.value = 'corporate';\
            \}\
\
            // Scroll to form and highlight\
            const contactSection = document.getElementById('contact');\
            contactSection.scrollIntoView(\{ behavior: 'smooth' \});\
            \
            setTimeout(() => \{\
                formMessage.focus();\
                formMessage.classList.add('ring-2', 'ring-brand-pink', 'border-brand-pink');\
                setTimeout(() => formMessage.classList.remove('ring-2', 'ring-brand-pink', 'border-brand-pink'), 1500);\
            \}, 800);\
        \}\
\
        // --- Standard UI Logic ---\
        document.addEventListener('DOMContentLoaded', () => \{\
            // Set current year in footer\
            document.getElementById('year').textContent = new Date().getFullYear();\
\
            // Navbar Scroll Effect\
            const navbar = document.getElementById('navbar');\
            window.addEventListener('scroll', () => \{\
                if (window.scrollY > 50) \{\
                    navbar.classList.add('bg-white', 'shadow-sm', 'py-4');\
                    navbar.classList.remove('bg-transparent', 'py-6');\
                \} else \{\
                    navbar.classList.add('bg-transparent', 'py-6');\
                    navbar.classList.remove('bg-white', 'shadow-sm', 'py-4');\
                \}\
            \});\
\
            // Mobile Menu Toggle\
            const mobileBtn = document.getElementById('mobile-menu-btn');\
            const mobileMenu = document.getElementById('mobile-menu');\
            const mobileLinks = document.querySelectorAll('.mobile-link');\
            const icon = mobileBtn.querySelector('i');\
            let isMenuOpen = false;\
\
            function toggleMenu() \{\
                isMenuOpen = !isMenuOpen;\
                if (isMenuOpen) \{\
                    mobileMenu.classList.remove('opacity-0', 'pointer-events-none');\
                    mobileMenu.classList.add('opacity-100', 'pointer-events-auto');\
                    icon.classList.remove('fa-bars');\
                    icon.classList.add('fa-times');\
                    document.body.style.overflow = 'hidden';\
                \} else \{\
                    mobileMenu.classList.add('opacity-0', 'pointer-events-none');\
                    mobileMenu.classList.remove('opacity-100', 'pointer-events-auto');\
                    icon.classList.remove('fa-times');\
                    icon.classList.add('fa-bars');\
                    document.body.style.overflow = '';\
                \}\
            \}\
\
            mobileBtn.addEventListener('click', toggleMenu);\
            mobileLinks.forEach(link => \{\
                link.addEventListener('click', toggleMenu);\
            \});\
\
            // Scroll Reveal Animation (Intersection Observer)\
            const revealElements = document.querySelectorAll('.reveal');\
            \
            const revealObserver = new IntersectionObserver((entries, observer) => \{\
                entries.forEach(entry => \{\
                    if (entry.isIntersecting) \{\
                        entry.target.classList.add('active');\
                        // Optional: Stop observing once revealed\
                        observer.unobserve(entry.target);\
                    \}\
                \});\
            \}, \{\
                root: null,\
                threshold: 0.1,\
                rootMargin: "0px 0px -50px 0px"\
            \});\
\
            revealElements.forEach(el => revealObserver.observe(el));\
\
            // Form Submission Mock\
            const form = document.getElementById('contactForm');\
            const successMsg = document.getElementById('formSuccess');\
\
            form.addEventListener('submit', (e) => \{\
                e.preventDefault();\
                // Simulate network request\
                const btn = form.querySelector('button[type="submit"]');\
                const originalText = btn.textContent;\
                btn.textContent = 'Sending...';\
                \
                setTimeout(() => \{\
                    btn.textContent = originalText;\
                    form.reset();\
                    successMsg.classList.remove('hidden');\
                    setTimeout(() => \{\
                        successMsg.classList.add('hidden');\
                    \}, 5000);\
                \}, 1500);\
            \});\
        \});\
    </script>\
</body>\
</html>}